# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM provider for the Investigator Agent (NCE): "groq" or "none".
# "none" (or a missing key/model) makes the system use the deterministic fallback investigator.
LLM_PROVIDER=groq

# Groq (groq.com) — OpenAI-compatible API. Keys start with "gsk_".
# Note: Groq is NOT xAI Grok. A future xAI/Claude provider is a separate adapter.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Bounded LLM requests
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000

# Knowledge store (relative paths resolve against the project root)
AGENTSOC_DB_PATH=data/agentsoc.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
