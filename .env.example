# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM provider for the Investigator Agent (NCE): "groq" or "none".
# "none" (or a missing key/model) makes the system use the deterministic fallback investigator.
LLM_PROVIDER=groq

# Groq (groq.com) — OpenAI-compatible API. Keys start with "gsk_".
# Note: Groq is NOT xAI Grok. A future xAI/Claude provider is a separate adapter.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Bounded LLM requests
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4000

# Knowledge store (relative paths resolve against the project root)
AGENTSOC_DB_PATH=data/agentsoc.db

# Sign-in sessions
AGENTSOC_SESSION_IDLE_MINUTES=30
AGENTSOC_SESSION_MAX_HOURS=8
# Set to true whenever AgentSOC is reached over HTTPS.
AGENTSOC_COOKIE_SECURE=false
AGENTSOC_LOGIN_MAX_FAILURES=5
AGENTSOC_LOGIN_LOCKOUT_MINUTES=15

# Credential encryption key(s), comma-separated; the first encrypts. Generate with
# `python scripts/manage_credentials.py generate-key`. Empty = credential storage disabled.
# Back it up separately from the database. See docs/security_foundations.md.
AGENTSOC_CREDENTIAL_KEY=

# Poll enabled organisation databases in the background (true/false).
AGENTSOC_SYNC_SCHEDULER=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
